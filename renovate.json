{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":gitSignOff"
  ],
  "dependencyDashboard": true,
  "dependencyDashboardHeader": "Project settings are at https://developer.mend.io/",
  "labels": [
    "changelog:dependencies"
  ],
  "minimumReleaseAge": "7 days",
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security",
      "changelog:dependencies"
    ],
    "minimumReleaseAge": "0 days"
  },
  "suppressNotifications": [
    "prEditedNotification"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update annotated Helm chart version variables in shell scripts",
      "managerFilePatterns": [
        "/\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>helm|docker) depName=(?<depName>\\S+)(?: registryUrl=(?<registryUrl>\\S+))?\\s+[A-Z][A-Z0-9_]*=\"(?:\\$\\{[A-Z][A-Z0-9_]*:-)?(?<currentValue>[^\"}]+)\\}?\""
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^scripts\\/demo\\/jaeger-chart\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>git-refs) depName=(?<depName>\\S+)\\s+JAEGER_CHART_REF=\"(?<currentValue>[^\"]+)\"\\s+JAEGER_CHART_COMMIT=\"(?<currentDigest>[a-f0-9]+)\""
      ],
      "versioningTemplate": "git"
    },
    {
      "customType": "regex",
      "description": "Track digests for the three monitoring hook image tags",
      "managerFilePatterns": [
        "/^examples\\/oci\\/monitoring-values\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=docker depName=(?<depName>\\S+)\\s+tag: \"(?<currentValue>[^\"@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Review Helmfile tool upgrades with refreshed release checksums",
      "managerFilePatterns": [
        "/^scripts\\/demo\\/helmfile-tools\\.lock\\.json$/"
      ],
      "matchStrings": [
        "\"repository\":\\s*\"(?<depName>[^\"]+)\",\\s*\"version\":\\s*\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""
      ],
      "datasourceTemplate": "github-releases"
    }
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/^examples\\/(?:oci|otel-demo)\\/.*\\.ya?ml$/"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/^examples\\/(?:oci|otel-demo)\\/.*values\\.yaml$/"
    ]
  },
  "schedule": [
    "at any time"
  ],
  "automerge": false,
  "packageRules": [
    {
      "description": "Review hosted demo updates daily, independently of the monthly repository schedule",
      "matchFileNames": [
        "examples/oci/**",
        "examples/otel-demo/**",
        "scripts/demo/jaeger-chart.sh"
      ],
      "schedule": [
        "at any time"
      ],
      "automerge": false
    },
    {
      "matchFileNames": [
        "examples/oci/**"
      ],
      "groupName": "OCI demo Jaeger"
    },
    {
      "matchFileNames": [
        "examples/otel-demo/**"
      ],
      "groupName": "OTel demo Jaeger"
    },
    {
      "description": "Require review for OTel Demo Helm chart upgrades",
      "matchManagers": [
        "custom.regex",
        "helmfile"
      ],
      "matchPackageNames": [
        "opentelemetry-demo"
      ],
      "automerge": false
    },
    {
      "description": "Keep the OTel demo OpenSearch charts on supported 3.x releases and update both charts together in the script and Helmfile locations",
      "matchManagers": [
        "custom.regex",
        "helmfile"
      ],
      "matchDatasources": [
        "helm"
      ],
      "matchPackageNames": [
        "opensearch",
        "opensearch-dashboards"
      ],
      "groupName": "OTel demo OpenSearch Helm charts",
      "groupSlug": "otel-demo-opensearch-helm",
      "minimumGroupSize": 4,
      "allowedVersions": "/^3\\./",
      "automerge": false
    },
    {
      "matchFileNames": [
        "examples/oci/monitoring-values.yaml"
      ],
      "groupName": "OCI demo monitoring"
    },
    {
      "description": "Review kubectl and webhook-certgen tag changes with Kubernetes and chart upgrades",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchFileNames": [
        "examples/oci/monitoring-values.yaml"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "rollback",
        "replacement"
      ],
      "enabled": false,
      "matchPackageNames": [
        "registry.k8s.io/kubectl",
        "ghcr.io/jkroepke/kube-webhook-certgen"
      ]
    },
    {
      "matchFileNames": [
        "examples/otel-demo/otel-demo-values.yaml"
      ],
      "groupName": "OTel demo application"
    },
    {
      "matchFileNames": [
        "examples/oci/load-generator/**"
      ],
      "groupName": "OCI demo Jaeger"
    },
    {
      "matchFileNames": [
        "examples/otel-demo/load-generator*"
      ],
      "groupName": "OTel demo Jaeger"
    },
    {
      "matchFileNames": [
        "examples/otel-demo/jaeger-values.yaml"
      ],
      "groupName": "OTel demo Jaeger"
    },
    {
      "matchPackageNames": [
        "kube-prometheus-stack"
      ],
      "groupName": "OCI demo monitoring"
    },
    {
      "matchPackageNames": [
        "opentelemetry-demo"
      ],
      "matchDatasources": [
        "helm"
      ],
      "groupName": "OTel demo application",
      "matchManagers": [
        "custom.regex",
        "helmfile"
      ]
    },
    {
      "matchPackageNames": [
        "https://github.com/jaegertracing/helm-charts.git"
      ],
      "groupName": "Hosted demo Jaeger chart"
    },
    {
      "matchFileNames": [
        "examples/oci/**",
        "examples/otel-demo/**"
      ],
      "matchDatasources": [
        "kubernetes-api"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github-actions deps"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "patch",
        "digest"
      ],
      "enabled": false
    },
    {
      "description": "Keep the adoption Helm CLI on the established production writer major",
      "matchFileNames": [
        "scripts/demo/helmfile-tools.lock.json"
      ],
      "matchPackageNames": [
        "helm/helm"
      ],
      "allowedVersions": "<5.0.0"
    }
  ]
}
